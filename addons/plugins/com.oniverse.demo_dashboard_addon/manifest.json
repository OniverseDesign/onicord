{
  "id": "com.oniverse.demo_dashboard_addon",
  "name": "Demo Widgets Addon",
  "version": "0.1.0",
  "scope": "hybrid",
  "description": "Demostración de widgets extensibles locales y colaborativos P2P para el Panel de Widgets.",
  "author": "Oniverse Team",
  "main": "index.js",
  "permissions": [
    "user.profile",
    "server.info",
    "audio.state",
    "gaming.activity",
    "storage",
    "p2p.network"
  ],
  "dashboardWidgets": [
    {
      "id": "pomodoro_timer",
      "title": "Temporizador Pomodoro",
      "badgeText": "Local",
      "type": "local",
      "bgVariant": "dark",
      "entryPoint": "widgets/pomodoro.html",
      "defaultGeo": {
        "x": 1,
        "y": 1,
        "w": 2,
        "h": 2
      }
    },
    {
      "id": "squad_notes",
      "title": "Notas de la Sala P2P",
      "badgeText": "P2P Live",
      "type": "collaborative",
      "bgVariant": "sapphire",
      "entryPoint": "widgets/p2p_notes.html",
      "defaultGeo": {
        "x": 3,
        "y": 1,
        "w": 2,
        "h": 2
      }
    }
  ]
}