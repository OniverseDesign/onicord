{
  "name": "onicord",
  "version": "0.2.5",
  "description": "Onicord",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "Oniverse <oniverse.dsg@gmail.com>",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "electron": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "electron:dev": "wait-on -t 60000 http-get://127.0.0.1:5173 && npm run electron",
    "prestart": "kill-port 5173",
    "start": "node scripts/dev.cjs",
    "start:concurrent": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm run dev\" \"npm run electron:dev\"",
    "build": "vite build",
    "icons": "node scripts/prepare-icons.cjs",
    "ensure-ytdlp": "node scripts/ensure-ytdlp.cjs",
    "pack": "node scripts/ensure-ytdlp.cjs --platform=win && npm run icons && npm run build && electron-builder --win nsis",
    "pack:portable": "node scripts/ensure-ytdlp.cjs --platform=win && npm run icons && npm run build && electron-builder --win portable",
    "pack:linux": "node scripts/ensure-ytdlp.cjs --platform=linux && npm run icons && npm run build && electron-builder --linux AppImage deb",
    "pack:mac": "node scripts/ensure-ytdlp.cjs --platform=mac && npm run icons && npm run build && electron-builder --mac dmg zip",
    "pack:all": "node scripts/ensure-ytdlp.cjs --platform=all && npm run icons && npm run build && electron-builder -mwl",
    "dist": "npm run pack",
    "export:github": "node scripts/export-to-github.cjs",
    "check:i18n": "node check-i18n.js",
    "tools:backup": "node scripts/restore-local-tools.cjs backup",
    "tools:restore": "node scripts/restore-local-tools.cjs restore",
    "postinstall": "node scripts/install-better-sqlite3.cjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "adm-zip": "^0.6.0",
    "b4a": "^1.6.9",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "hyperswarm": "^4.9.0",
    "torrent-stream": "^1.2.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "daisyui": "^5.5.23",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "eslint": "^10.4.1",
    "hls.js": "^1.7.4",
    "i18next": "^26.3.3",
    "kill-port": "^2.0.1",
    "pdfjs-dist": "^4.9.155",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-resizable-panels": "^4.11.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "uisfx": "^0.4.0",
    "vite": "^5.4.14",
    "vite-plugin-svgr": "^5.2.0",
    "wait-on": "^8.0.2",
    "zustand": "^5.1.0"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.onicord.voice",
    "productName": "Onicord",
    "icon": "build/icon.png",
    "copyright": "Copyright © 2026 Oniverse",
    "publish": {
      "provider": "github",
      "owner": "OniverseDesign",
      "repo": "onicord",
      "releaseType": "release"
    },
    "protocols": [
      {
        "name": "Onicord",
        "role": "Viewer",
        "schemes": [
          "onicord"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "onipkg",
        "name": "Onicord Package",
        "description": "Onicord Unified Package",
        "icon": "build/icon.png",
        "role": "Viewer"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/join/**",
      "electron/**/*",
      "!electron/bin/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/@ffmpeg-installer/**"
    ],
    "win": {
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        },
        {
          "from": "electron/bin/win/yt-dlp.exe",
          "to": "bin/yt-dlp.exe"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Onicord",
      "installerLanguages": [
        "es_ES",
        "en_US"
      ],
      "language": "1034"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "extraResources": [
        {
          "from": "electron/bin/linux/yt-dlp",
          "to": "bin/yt-dlp"
        }
      ],
      "maintainer": "Oniverse <oniverse.dsg@gmail.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;Chat;",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "mac": {
      "extraResources": [
        {
          "from": "electron/bin/mac/yt-dlp",
          "to": "bin/yt-dlp"
        }
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
